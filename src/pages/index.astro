
---
const base = import.meta.env.BASE_URL;
const github = 'https://github.com/soylegendario/trunks';
const releases = `${github}/releases`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#100b29" />
    <meta
      name="description"
      content="Trunks — Your workspace. Your flow. A terminal workspace built for developers."
    />
    <title>Trunks — Your workspace. Your flow.</title>
  </head>

  <body>
    <main class="landing">
      <header class="header">
        <a href="/" class="brand">TRUNKS<span>.</span></a>

        <a
          href={github}
          class="github-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.02-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 .1.9 2.16 3.44 1.54.1-.73.39-1.22.71-1.5-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.27-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06v3.1c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"
            />
          </svg>
          GitHub
        </a>
      </header>

      <section class="hero">
        <div class="intro">
          <span class="eyebrow">OPEN SOURCE · DEVELOPER TOOLS</span>

          <h1>Your workspace.<br />Your flow.</h1>

          <p>
            A terminal workspace built for developers.
            Organize your work, manage your sessions
            and stay focused.
          </p>

          <div class="actions">
            <a
              class="button primary"
              href={releases}
              target="_blank"
              rel="noopener noreferrer"
            >
              Explore releases <span>↗</span>
            </a>

            <a
              class="button secondary"
              href={github}
              target="_blank"
              rel="noopener noreferrer"
            >
              View source code
            </a>
          </div>
        </div>

        <div class="showcase">
          <img
            src={`${base}/trunks_concept.png`}
            alt="Trunks Terminal Workspace application preview"
            fetchpriority="high"
          />
        </div>
      </section>

      <footer>
        <span>© {new Date().getFullYear()} Trunks</span>
        <span>Built for developers. Designed around your workflow.</span>
        <a href={github} target="_blank" rel="noopener noreferrer">
          Open source on GitHub ↗
        </a>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-width: 320px;
    background: #0c091b;
  }

  :global(body) {
    margin: 0;
    color: #fff;
    font-family: Inter, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .landing {
    min-height: 100vh;
    padding: 0 6%;
    background:
      radial-gradient(ellipse at 50% 35%, #29145c 0%, transparent 55%),
      #0c091b;
    display: flex;
    flex-direction: column;
  }

  .header {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ffffff12;
  }

  .brand {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 2px;
    color: white;
    text-decoration: none;
  }

  .brand span {
    color: #bb70ff;
  }

  .github-link {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #ddd6ef;
    text-decoration: none;
    font-size: 14px;
  }

  .github-link svg {
    width: 21px;
    height: 21px;
  }

  .hero {
    width: 100%;
    max-width: 1200px;
    margin: auto;
    padding: 65px 0 45px;
    text-align: center;
  }

  .eyebrow {
    color: #c28aff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  h1 {
    margin: 20px 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.08;
    letter-spacing: -3px;
  }

  .intro p {
    max-width: 560px;
    margin: 0 auto;
    color: #b7adc9;
    font-size: 17px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin: 30px 0 48px;
  }

  .button {
    padding: 14px 23px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    transition: transform .2s, background .2s;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .primary {
    color: white;
    background: linear-gradient(110deg, #8d43ed, #c04eea);
    box-shadow: 0 5px 25px #a04bfa35;
  }

  .secondary {
    color: #eee6fa;
    border: 1px solid #ffffff35;
    background: #ffffff08;
  }

  .showcase {
    width: 100%;
    margin: 0 auto;
  }

  .showcase img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 25px 90px #a14aff25;
  }

  footer {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    border-top: 1px solid #ffffff12;
    color: #9288a8;
    font-size: 12px;
  }

  footer a {
    color: #c58aff;
    text-decoration: none;
  }

  @media (max-width: 650px) {
    .landing {
      padding: 0 5%;
    }

    .header {
      height: 70px;
    }

    .hero {
      padding-top: 55px;
    }

    h1 {
      letter-spacing: -1.5px;
    }

    .intro p {
      font-size: 15px;
    }

    .actions {
      margin-bottom: 35px;
    }

    .button {
      width: 100%;
    }

    footer {
      padding: 22px 0;
      flex-direction: column;
      text-align: center;
    }
  }
</style>
